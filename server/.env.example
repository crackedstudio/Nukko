# ── Gameplay database (this game's own Supabase project) ──────
PORT=3001
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Shared rewards database (Blokaz + Nukko) ──────────────────
# A DIFFERENT Supabase project. Service-role only — never expose to the browser.
REWARDS_SUPABASE_URL=
REWARDS_SUPABASE_SERVICE_ROLE_KEY=

# ── Admin API ─────────────────────────────────────────────────
# The admin page at /#admin is gated on wallet signature. Defaults to the
# owner address below; comma-separate to allow more.
# ADMIN_WALLETS=0xe1a0F916e859624D4edbadA23E4382D327EAf626
#
# Optional break-glass token for when the wallet is unavailable. While unset,
# a wallet signature is the ONLY way in — which is the intended setup.
# ADMIN_TOKEN=

# ── Chain indexer (optional — sensible defaults) ───────────────
# CELO_RPC_URL=https://forno.celo.org
# NUKKO_CONTRACT_ADDRESS=0x8c7BA50a06ECF8a3d9930d8B537B6de00439B552
# TREASURY_ADDRESS=0xAF3B714fDDa5A3b4311f78ccfe0873A990819A35
# INDEXER_INTERVAL_MS=60000
# INDEXER_BOOTSTRAP_BLOCKS=700000
#
# Required on Supabase, where POST /api/indexer/sync replaces the timer: the
# scheduler (.github/workflows/index-chain.yml) sends it as x-cron-secret.
# CRON_SECRET=

# ── Cash payout test whitelist ────────────────────────────────
# Reaching level 4 legitimately costs a week of play, which is too slow to
# exercise a cash payout end to end. Addresses listed here (comma-separated,
# case-insensitive) are also paid at the test levels in TEST_CASH_LEVELS —
# level 1 by default. Nobody else is: the public milestones stay 4, 8 and 12.
#
# Leave it UNSET in normal operation. Unsetting it reverts the behaviour, the
# fundable pool levels and the admin portal's level picker in one move.
# TEST_CASH_ADDRESSES=0xFd1a3980f7473bdFE7461e78ADDe78c33d7b006b
