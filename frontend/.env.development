# Loaded ONLY by `npm run dev` (vite mode=development) and it OVERRIDES .env —
# so editing VITE_API_URL in .env has no effect on a dev session.
#
# Dev sessions call the deployed API (the `api` Supabase Edge Function)
# straight from the browser, which also works through an ngrok tunnel.
#
# To run against a local server (npm run dev in server/) instead, leave it
# empty: the app then calls /api/... on its own origin and vite.config.js
# proxies it to http://localhost:3001 (or API_PROXY_TARGET).
VITE_API_URL=https://kvgcsucroxqsszkadpjl.supabase.co/functions/v1
